{
  "name": "sjrslms-docs",
  "type": "module",
  "version": "1.7.0",
  "description": "Official documentation site for the SJRS Library Management System",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PC-Mender/sjrs-lms-docs.git"
  },
  "homepage": "https://docs.sjrslms.in",
  "bugs": {
    "url": "https://github.com/PC-Mender/sjrs-lms-docs/issues"
  },
  "license": "ISC",
  "author": "SJRS LMS Contributors",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "astro check",
    "feedback:dev": "wrangler dev --config feedback/wrangler.toml",
    "feedback:deploy": "wrangler deploy --config feedback/wrangler.toml",
    "feedback:check": "wrangler deploy --dry-run --config feedback/wrangler.toml",
    "feedback:typecheck": "tsc --noEmit -p feedback/tsconfig.json",
    "typecheck": "astro check && tsc --noEmit -p feedback/tsconfig.json",
    "feedback:migrate": "wrangler d1 migrations apply FEEDBACK_DB --config feedback/wrangler.toml",
    "check:lifecycle": "node scripts/check-doc-lifecycle.js",
    "validate:csp": "node scripts/validate-csp-hashes.js",
    "release": "commit-and-tag-version"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/starlight": "0.41.3",
    "astro": "7.1.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "brace-expansion": ">=1.1.16",
    "defu": "6.1.7",
    "handlebars": "4.7.9",
    "h3": "1.15.11",
    "lodash": "4.18.1",
    "picomatch": "4.0.4",
    "smol-toml": "1.7.0",
    "volar-service-yaml": "0.0.70",
    "yaml": "2.9.0",
    "esbuild": "0.28.1",
    "fast-uri": ">=3.1.4",
    "fast-xml-parser": ">=5.10.1",
    "postcss": ">=8.5.18",
    "sharp": ">=0.35.0",
    "svgo": ">=4.0.2",
    "ws": ">=8.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "commit-and-tag-version": "13.0.0",
    "wrangler": "^4.59.1"
  }
}
